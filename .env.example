# ─── Copia este ficheiro para .env e preenche os valores ───────────────────
# O ficheiro .env NÃO deve ser adicionado ao Git (já está no .gitignore)

# URL do Google Apps Script Web App (obtido depois de publicar o script)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_ID_AQUI/exec

# Senha do painel admin (muda para algo seguro)
VITE_ADMIN_PASSWORD=catequese2025

# Nome do teu centro de catequese
VITE_NOME_CENTRO=Centro de Catequese — Luanda

# Ano catequético activo
VITE_ANO_CATEQUETICO=2024/2025
